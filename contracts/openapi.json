              "agent_state",
              "user_state",
              "false_interruption",
              "overlapping_speech",
              "session_close",
              "tool_execution"
            ],
            "title": "Type"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data",
            "description": "agent_state/user_state: {from, to}; false_interruption: {resumed}; overlapping_speech: {is_interruption, probability, detection_delay_s}; session_close: {reason, error}; tool_execution: {tool_name, call_ref, phase, status?}."
          }
        },
        "type": "object",
