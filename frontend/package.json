{
  "name": "agentdoctor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html README.md",
    "test:live": "VITE_RUN_LIVE_TESTS=true VITE_USE_MOCKS=false vitest run src/live-api.test.tsx"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "prettier": "3.8.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
